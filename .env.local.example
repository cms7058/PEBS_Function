# Copy this file to .env.local in the project root, choose one provider,
# then restart scripts/start.sh. Never commit .env.local.
# Local single-user demo using a logged-in Codex CLI (no OPENAI_API_KEY):
# BOOK_TO_SKILL_PROVIDER=codex

# OpenAI API mode:
BOOK_TO_SKILL_PROVIDER=openai
OPENAI_API_KEY=
BOOK_TO_SKILL_MODEL=gpt-4.1-mini
# Optional, only for a compatible API endpoint:
# BOOK_TO_SKILL_API_BASE=https://api.openai.com/v1

# Alternative: local Ollama, with no OPENAI_API_KEY:
# BOOK_TO_SKILL_PROVIDER=ollama
# BOOK_TO_SKILL_MODEL=<a locally installed model>
# BOOK_TO_SKILL_OLLAMA_BASE=http://127.0.0.1:11434

# Account deployment (localhost development defaults need no secret here)
# APP_ENV=production
# APP_URL=https://your-domain.example
# DATABASE_URL=postgresql://user:password@host/pebs
# PEBS_SMTP_HOST=smtp.example.com
# PEBS_SMTP_PORT=587
# PEBS_SMTP_USER=service@example.com
# PEBS_SMTP_PASSWORD=
# PEBS_SMTP_FROM=service@example.com
# PEBS_SMTP_SECURITY=starttls
# Configure WeChat, Alipay and Stripe credentials through the administrator UI.
